# Causal 最適化: q_start より前の K ブロックは causal mask 不要 → tl.where スキップ。
import math

import torch
import triton
import triton.language as tl

_SCALE = 1.0 / math.sqrt({{ head_dim }})


@triton.jit
def _sdpa_kernel(
    q_ptr, k_ptr, v_ptr, out_ptr,
    S,
    stride_qb, stride_qs, stride_qd,
    stride_kb, stride_ks, stride_kd,
    stride_vb, stride_vs, stride_vd,
    stride_ob, stride_os, stride_od,
    scale,
    IS_CAUSAL: tl.constexpr,
    BLOCK_S: tl.constexpr,
    HEAD_DIM: tl.constexpr,
):
    batch = tl.program_id(0)
    q_blk = tl.program_id(1)

    q_start = q_blk * BLOCK_S
    offs_qs = q_start + tl.arange(0, BLOCK_S)
    offs_d = tl.arange(0, HEAD_DIM)

    # Load Q tile [BLOCK_S, HEAD_DIM]
    q_ptrs = q_ptr + batch * stride_qb + offs_qs[:, None] * stride_qs + offs_d[None, :] * stride_qd
    q_mask = offs_qs < S
    q = tl.load(q_ptrs, mask=q_mask[:, None], other=0.0).to(tl.float32)

    # Online softmax accumulators
    m_i = tl.full([BLOCK_S], float("-inf"), dtype=tl.float32)
    l_i = tl.zeros([BLOCK_S], dtype=tl.float32)
    acc = tl.zeros([BLOCK_S, HEAD_DIM], dtype=tl.float32)

    # Causal: K blocks with k_end <= q_start are fully attended (no causal mask needed).
    # Only the last overlapping block needs the causal tl.where.
    if IS_CAUSAL:
        safe_end = q_start  # K blocks with k_start < q_start and k_end <= q_start are safe
        # Phase 1: K blocks entirely before q_start — skip causal check
        for k_start in range(0, safe_end, BLOCK_S):
            offs_ks = k_start + tl.arange(0, BLOCK_S)
            k_mask = offs_ks < S
            k_ptrs = k_ptr + batch * stride_kb + offs_ks[:, None] * stride_ks + offs_d[None, :] * stride_kd
            k = tl.load(k_ptrs, mask=k_mask[:, None], other=0.0).to(tl.float32)
            v_ptrs = v_ptr + batch * stride_vb + offs_ks[:, None] * stride_vs + offs_d[None, :] * stride_vd
            v = tl.load(v_ptrs, mask=k_mask[:, None], other=0.0).to(tl.float32)
            scores = tl.dot(q.to(tl.float16), tl.trans(k.to(tl.float16))).to(tl.float32) * scale
            scores = tl.where(k_mask[None, :], scores, float("-inf"))
            # No causal mask needed: all K positions < q_start <= all Q positions
            m_new = tl.maximum(m_i, tl.max(scores, axis=1))
            alpha = tl.exp(m_i - m_new)
            p = tl.exp(scores - m_new[:, None])
            l_i = l_i * alpha + tl.sum(p, axis=1)
            acc = acc * alpha[:, None] + tl.dot(p.to(tl.float16), v.to(tl.float16)).to(tl.float32)
            m_i = m_new
        # Phase 2: K blocks overlapping with q_start — apply causal mask
        for k_start in range(safe_end, S, BLOCK_S):
            offs_ks = k_start + tl.arange(0, BLOCK_S)
            k_mask = offs_ks < S
            k_ptrs = k_ptr + batch * stride_kb + offs_ks[:, None] * stride_ks + offs_d[None, :] * stride_kd
            k = tl.load(k_ptrs, mask=k_mask[:, None], other=0.0).to(tl.float32)
            v_ptrs = v_ptr + batch * stride_vb + offs_ks[:, None] * stride_vs + offs_d[None, :] * stride_vd
            v = tl.load(v_ptrs, mask=k_mask[:, None], other=0.0).to(tl.float32)
            scores = tl.dot(q.to(tl.float16), tl.trans(k.to(tl.float16))).to(tl.float32) * scale
            scores = tl.where(k_mask[None, :], scores, float("-inf"))
            scores = tl.where(offs_qs[:, None] >= offs_ks[None, :], scores, float("-inf"))
            m_new = tl.maximum(m_i, tl.max(scores, axis=1))
            alpha = tl.exp(m_i - m_new)
            p = tl.exp(scores - m_new[:, None])
            l_i = l_i * alpha + tl.sum(p, axis=1)
            acc = acc * alpha[:, None] + tl.dot(p.to(tl.float16), v.to(tl.float16)).to(tl.float32)
            m_i = m_new
    else:
        for k_start in range(0, S, BLOCK_S):
            offs_ks = k_start + tl.arange(0, BLOCK_S)
            k_mask = offs_ks < S
            k_ptrs = k_ptr + batch * stride_kb + offs_ks[:, None] * stride_ks + offs_d[None, :] * stride_kd
            k = tl.load(k_ptrs, mask=k_mask[:, None], other=0.0).to(tl.float32)
            v_ptrs = v_ptr + batch * stride_vb + offs_ks[:, None] * stride_vs + offs_d[None, :] * stride_vd
            v = tl.load(v_ptrs, mask=k_mask[:, None], other=0.0).to(tl.float32)
            scores = tl.dot(q.to(tl.float16), tl.trans(k.to(tl.float16))).to(tl.float32) * scale
            scores = tl.where(k_mask[None, :], scores, float("-inf"))
            m_new = tl.maximum(m_i, tl.max(scores, axis=1))
            alpha = tl.exp(m_i - m_new)
            p = tl.exp(scores - m_new[:, None])
            l_i = l_i * alpha + tl.sum(p, axis=1)
            acc = acc * alpha[:, None] + tl.dot(p.to(tl.float16), v.to(tl.float16)).to(tl.float32)
            m_i = m_new

    # Normalize
    acc = acc / l_i[:, None]

    out_ptrs = out_ptr + batch * stride_ob + offs_qs[:, None] * stride_os + offs_d[None, :] * stride_od
    tl.store(out_ptrs, acc.to({{ out_tl }}), mask=q_mask[:, None])


def kernel_fn(q, k, v, scale=None, is_causal=False):
    if scale is None:
        scale = _SCALE
    B, S, D = q.shape
    out = torch.empty_like(q)
    grid = (B, triton.cdiv(S, {{ block_size }}))
