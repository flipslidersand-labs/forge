    x_acc = x.to(tl.{{ acc_tl }})
    out = (x_acc - mean.to(tl.{{ acc_tl }})) * rstd.to(tl.{{ acc_tl }}) * w + b
    tl.store(out_ptr + row * N + cols, out.to(tl.{{ out_tl }}), mask=mask)


